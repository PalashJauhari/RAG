# HotpotQA retriever benchmark — copy to benchmarking/hotpotqa/.env
# Do NOT use the repo root .env for benchmark scripts.

# --- OpenAI (dense embeddings + RAGAS judge LLM) ---
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
HOTPOTQA_RAGAS_MODEL=gpt-4o-mini

# --- Qdrant ---
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=hotpotqa_fullwiki_validation
QDRANT_DENSE_VECTOR_NAME=dense
QDRANT_BM25_VECTOR_NAME=bm25
QDRANT_COLBERT_VECTOR_NAME=colbert
QDRANT_BM25_MODEL=Qdrant/bm25

# --- Retrieval flags (must align with --strategy; see README) ---
USE_BM25=true
USE_LATE_INTERACTION=true
USE_MMR=true

# --- Retrieval tuning ---
RETRIEVAL_TOP_K=8
RETRIEVAL_TOP_K_MAX=64
RETRIEVAL_CANDIDATE_DENSE_MMR=100
RETRIEVAL_CANDIDATE_DENSE_MMR_MAX=500
RETRIEVAL_CANDIDATE_BM25=100
RETRIEVAL_CANDIDATE_BM25_MAX=500
RETRIEVAL_CANDIDATE_FOR_LATE_INTERACTION=100
RETRIEVAL_CANDIDATE_FOR_LATE_INTERACTION_MAX=500
RETRIEVAL_MMR_DIVERSITY=0.5
REQUEST_TIMEOUT_SECONDS=60

# --- Jina (required for fast_bm25_late_interaction_retrieval only) ---
JINA_API_KEY=
JINA_COLBERT_MODEL=jina-colbert-v2
JINA_COLBERT_DIMENSIONS=128
JINA_MULTI_VECTOR_URL=https://api.jina.ai/v1/multi-vector

# --- Dataset preparation ---
HOTPOTQA_DATASET_NAME=hotpotqa/hotpot_qa
HOTPOTQA_DATASET_CONFIG=fullwiki
HOTPOTQA_SPLIT=validation
HOTPOTQA_MAX_QUESTIONS=500
HOTPOTQA_UPLOAD_BATCH_SIZE=64

# --- Experiment output ---
HOTPOTQA_EXPERIMENT_NAME=default_experiment

# --- Optional rate limiting (upload / RAGAS) ---
OPENAI_RATE_LIMIT_ENABLED=true
OPENAI_RATE_LIMIT_REQUESTS_PER_SECOND=1.0
OPENAI_RATE_LIMIT_CHECK_EVERY_N_SECONDS=0.1
OPENAI_RATE_LIMIT_MAX_BUCKET_SIZE=5.0