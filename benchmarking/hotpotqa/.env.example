OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_SUMMARY_MODEL=gpt-4.1-mini
OPENAI_TEMPERATURE=0

QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=hotpotqa_fullwiki_validation
QDRANT_DENSE_VECTOR_NAME=dense
QDRANT_BM25_VECTOR_NAME=bm25
QDRANT_COLBERT_VECTOR_NAME=colbert
QDRANT_BM25_MODEL=Qdrant/bm25

USE_BM25=true
USE_LATE_INTERACTION=true
USE_MMR=true

RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATE_LIMIT=100
RETRIEVAL_MMR_DIVERSITY=0.5

JINA_API_KEY=
JINA_COLBERT_MODEL=jina-colbert-v2
JINA_COLBERT_DIMENSIONS=128
JINA_MULTI_VECTOR_URL=https://api.jina.ai/v1/multi-vector

HOTPOTQA_DATASET_NAME=hotpotqa/hotpot_qa
HOTPOTQA_EXPERIMENT_NAME=default_experiment
HOTPOTQA_DATASET_CONFIG=fullwiki
HOTPOTQA_SPLIT=validation
HOTPOTQA_MAX_QUESTIONS=500
HOTPOTQA_UPLOAD_BATCH_SIZE=64
HOTPOTQA_RAGAS_MODEL=gpt-4o-mini



