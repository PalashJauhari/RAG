# Ingestion — copy to ingestion/.env (standalone from repo root and benchmark .env)
# cp ingestion/.env.example ingestion/.env
#
# Run from repo root:
#   python -m ingestion.download_arxiv_pdfs
#   python -m ingestion.unstructured_pipeline
#   python -m ingestion.upload_qdrant_embedding --no-enrich
#
# Optional. Used as mailto for OpenAlex polite pool and arXiv User-Agent.
# CONTACT_EMAIL=you@example.com

# ── Qdrant + embeddings (upload_qdrant_embedding) ────────────────────────────

OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
INGESTION_ENRICHMENT_MODEL=gpt-4o-mini

QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=arxiv_cs_ds
QDRANT_DENSE_VECTOR_NAME=dense
QDRANT_BM25_VECTOR_NAME=bm25
QDRANT_COLBERT_VECTOR_NAME=colbert
QDRANT_BM25_MODEL=Qdrant/bm25

USE_BM25=true
USE_LATE_INTERACTION=true

# Dense product quantization on the collection. Values: none | pq8 | pq16 | pq32
DENSE_PQ=none

JINA_API_KEY=
JINA_COLBERT_MODEL=jina-colbert-v2
JINA_COLBERT_DIMENSIONS=128
JINA_MULTI_VECTOR_URL=https://api.jina.ai/v1/multi-vector

REQUEST_TIMEOUT_SECONDS=60
INGESTION_UPLOAD_BATCH_SIZE=16

# ── Unstructured Jobs API (unstructured_pipeline) ────────────────────────────

# Required for python -m ingestion.unstructured_pipeline. From platform.unstructured.io → API Keys.
UNSTRUCTURED_API_KEY=

# Optional. Default SDK URL if empty. Example: https://platform.unstructuredapp.io/api/v1
UNSTRUCTURED_API_URL=

# Paths relative to ingestion/ unless absolute.
RAW_PDFS_DIR=raw_pdfs
CHUNKS_OUTPUT_PATH=raw_pdfs/chunks.json

# Max PDFs per job (Unstructured hard limit: 10).
UNSTRUCTURED_JOB_BATCH_SIZE=10

# Partition strategy. Values: hi_res | auto | fast | vlm
# hi_res = layout-aware extraction for arXiv PDFs with tables and figures.
UNSTRUCTURED_PARTITION_STRATEGY=hi_res

# If true, Table elements include metadata.text_as_html.
UNSTRUCTURED_INFER_TABLE_STRUCTURE=true

# If true, emit PageBreak elements. Values: true | false
UNSTRUCTURED_INCLUDE_PAGE_BREAKS=false

# If true, attach bounding-box coordinates to elements. Values: true | false
UNSTRUCTURED_COORDINATES=true

# OCR languages, comma-separated. Example: eng,fra
UNSTRUCTURED_OCR_LANGUAGES=eng

# Element types to exclude, comma-separated. Leave empty to keep all.
# Allowed: Address, EmailAddress, FigureCaption, Footer, Formula, Header, Image,
#          ListItem, NarrativeText, PageBreak, Table, Title, UncategorizedText
UNSTRUCTURED_EXCLUDE_ELEMENTS=

# Element types to extract as base64 image blocks, comma-separated. Example: Image,Table
UNSTRUCTURED_EXTRACT_IMAGE_BLOCK_TYPES=Image

# Text decoding for partition input. Example: utf-8
UNSTRUCTURED_ENCODING=utf-8

# Image description enrichment node (requires OpenAI in Unstructured platform UI, not here).
UNSTRUCTURED_IMAGE_DESCRIPTION_ENABLED=true

# Values: openai_image_description | anthropic_image_description | bedrock_image_description | vertexai_image_description
UNSTRUCTURED_IMAGE_DESCRIPTION_SUBTYPE=openai_image_description

# Values: openai | anthropic | bedrock | vertexai
UNSTRUCTURED_IMAGE_DESCRIPTION_PROVIDER=openai

# Model for image summaries. Example: gpt-4o-mini | gpt-4o
UNSTRUCTURED_IMAGE_DESCRIPTION_MODEL=gpt-4o-mini

# Chunk strategy subtype. Use chunk_by_title for section-aware paper chunks.
UNSTRUCTURED_CHUNK_STRATEGY=chunk_by_title

# Hard max chunk length in characters (Unstructured uses chars, not tokens).
UNSTRUCTURED_MAX_CHARACTERS=2000

# Soft target chunk length in characters.
UNSTRUCTURED_NEW_AFTER_N_CHARS=1500

# Character overlap when splitting oversized elements.
UNSTRUCTURED_OVERLAP=200

# If true, overlap applies to all chunks. Values: true | false
UNSTRUCTURED_OVERLAP_ALL=false

# Merge small sections below this character count.
UNSTRUCTURED_COMBINE_TEXT_UNDER_N_CHARS=400

# If true, a section may span multiple pages. Values: true | false
UNSTRUCTURED_MULTIPAGE_SECTIONS=true

# If true, keep source elements in metadata.orig_elements. Values: true | false
UNSTRUCTURED_INCLUDE_ORIG_ELEMENTS=true

# Optional contextual chunking. Values: empty (off) | v1 | true (alias for v1)
UNSTRUCTURED_CONTEXTUAL_CHUNKING=
