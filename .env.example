OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_TEMPERATURE=0

# --- Per-graph-node LLM models (see graph/graph.py) ---
# query_normalisation_node
QUERY_NORMALISATION_MODEL=gpt-5.4
# fact_decomposition_node + query_splitter_node
QUERY_DECOMPOSITION_MODEL=gpt-5.4
# recall_check_node (verify-only)
RECALL_CHECK_MODEL=gpt-5.4-mini
# create_queries_for_unsupported_facts_node
GAP_FILL_MODEL=gpt-5.5
# answer_node + partial_answer_node
FINAL_ANSWER_MODEL=gpt-5.4-mini
# faithfulness_node (groundedness check on cited catalog passages)
FAITHFULNESS_MODEL=gpt-5.4-mini
# query_complexity_node is deterministic (len(facts) > 1); no model env var

QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=arxiv_cs_ds
QDRANT_DENSE_VECTOR_NAME=dense
QDRANT_BM25_VECTOR_NAME=bm25
QDRANT_COLBERT_VECTOR_NAME=colbert
QDRANT_BM25_MODEL=Qdrant/bm25

USE_BM25=true
USE_LATE_INTERACTION=true
USE_MMR=true

# Must match ingestion. Values: none | pq8 | pq16 | pq32
DENSE_PQ=none

# Final docs per sub-query after RRF or ColBERT (fixed every pass)
RETRIEVAL_TOP_K=8

# Dense prefetch output (MMR internal pool = DENSE_MMR × 3 when USE_MMR=true)
RETRIEVAL_CANDIDATE_DENSE_MMR=50

# BM25 prefetch output
RETRIEVAL_CANDIDATE_BM25=50

# RRF candidate pool before ColBERT re-rank (late-interaction strategy only)
RETRIEVAL_CANDIDATE_FOR_LATE_INTERACTION=25
RETRIEVAL_MMR_DIVERSITY=0.5

# Cap concurrent Qdrant sub-queries when multiple retrieval queries run in parallel
RETRIEVAL_SUBQUERY_MAX_CONCURRENCY=8

JINA_API_KEY=
JINA_COLBERT_MODEL=jina-colbert-v2
JINA_COLBERT_DIMENSIONS=128
JINA_MULTI_VECTOR_URL=https://api.jina.ai/v1/multi-vector

# When false, no Langfuse spans are created and the SDK is not invoked at runtime.
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

CHECKPOINTER_USE_POSTGRES=false
DATABASE_URL=

GRAPH_RECURSION_LIMIT=100
GRAPH_MAX_CONCURRENCY=2
# LangGraph RetryPolicy per node (transient failures only; not recall repair loop)
GRAPH_NODE_RETRY_MAX_ATTEMPTS=3
# Repair loop budget (strategy_upgrade increments retrieval_retry_count each pass)
RETRIEVAL_LOOP_MAX_RETRIES=3
# Faithfulness fail (bad cited ids or grounding) → re-run answer/partial_answer
ANSWER_RETRY_MAX=5

OPENAI_RATE_LIMIT_ENABLED=true
OPENAI_RATE_LIMIT_REQUESTS_PER_SECOND=1.0
OPENAI_RATE_LIMIT_CHECK_EVERY_N_SECONDS=0.1
OPENAI_RATE_LIMIT_MAX_BUCKET_SIZE=5.0

API_URL=http://127.0.0.1:8000
REQUEST_TIMEOUT_SECONDS=60
