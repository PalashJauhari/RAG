OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_SUMMARY_MODEL=gpt-4.1-mini
OPENAI_TEMPERATURE=0

QUERY_NORMALISATION_MODEL=gpt-5.5-2026-04-23
QUERY_COMPLEXITY_MODEL=gpt-5.5-2026-04-23
QUERY_REWRITER_MODEL=gpt-5.5-2026-04-23
INFORMATION_EVALUATOR_MODEL=gpt-5.5-2026-04-23
FINAL_ANSWER_MODEL=gpt-5.4-mini-2026-03-17
QUERY_DECOMPOSITION_MODEL=gpt-5.4-mini-2026-03-17
QUERY_EXPANSION_MODEL=gpt-5.4-mini-2026-03-17
GAP_FILL_MODEL=gpt-5.4-mini-2026-03-17
INTENT_CORRECTION_REWRITER_MODEL=gpt-5.4-mini-2026-03-17

QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=
QDRANT_DENSE_VECTOR_NAME=dense
QDRANT_BM25_VECTOR_NAME=bm25
QDRANT_COLBERT_VECTOR_NAME=colbert
QDRANT_BM25_MODEL=Qdrant/bm25

USE_BM25=true
USE_LATE_INTERACTION=true
USE_MMR=true

# Max hits per sub-query; multi-query passes scale up to TOP_K × number of queries (id-deduped)
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATE_LIMIT=100
RETRIEVAL_MMR_DIVERSITY=0.5

JINA_API_KEY=
JINA_COLBERT_MODEL=jina-colbert-v2
JINA_COLBERT_DIMENSIONS=128
JINA_MULTI_VECTOR_URL=https://api.jina.ai/v1/multi-vector

# When false, no Langfuse spans are created and the SDK is not invoked at runtime.
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_BASE_URL=

CHECKPOINTER_USE_POSTGRES=false
DATABASE_URL=

GRAPH_RECURSION_LIMIT=100
GRAPH_MAX_CONCURRENCY=2
INSUFFICIENT_RECALL_MAX_RETRIES=3
INTENT_MISMATCH_MAX_RETRIES=2
STRATEGY_UPGRADE_MAX_RETRIES=3

MESSAGE_SUMMARY_TOKEN_THRESHOLD=100000
MESSAGE_SUMMARY_KEEP_RECENT=10

OPENAI_RATE_LIMIT_ENABLED=true
OPENAI_RATE_LIMIT_REQUESTS_PER_SECOND=1.0
OPENAI_RATE_LIMIT_CHECK_EVERY_N_SECONDS=0.1
OPENAI_RATE_LIMIT_MAX_BUCKET_SIZE=5.0

API_URL=http://127.0.0.1:8000
REQUEST_TIMEOUT_SECONDS=60
